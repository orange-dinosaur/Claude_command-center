{
    "buildCommand": "bun run build",
    "outputDirectory": "dist/client",
    "framework": null,
    "regions": ["fra1"],
    "functions": {
        "api/index.js": {
            "includeFiles": "dist/server/**"
        }
    },
    "routes": [
        {
            "src": "/(_expo/static|assets)/.*",
            "headers": {
                "cache-control": "public, max-age=31536000, immutable"
            },
            "continue": true
        },
        { "handle": "filesystem" },
        { "src": "/.*", "dest": "/api/index" }
    ]
}
