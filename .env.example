# Postgres connection strings. Server-side only, never prefix with EXPO_PUBLIC_,
# which would compile them into the client bundle.
# Direct connection, used by drizzle-kit for migrations.
DATABASE_URL=postgresql://user:password@host:5432/database
# Neon's pooled connection (host ends in -pooler), used by the app at runtime.
DATABASE_URL_POOLED=postgresql://user:password@host-pooler:5432/database

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The origin the auth API is served from (the deployed URL in production).
BETTER_AUTH_URL=http://localhost:8081

# Origin the native app calls the auth API on. Web and the Expo dev server
# resolve it themselves. A release iOS build has no host to infer and needs it
# set to the deployed URL. EXPO_PUBLIC_ is compiled into the client bundle, so
# this must stay a plain origin and never hold a secret.
EXPO_PUBLIC_AUTH_URL=

# Resend. Server-side only, the key sends mail on your behalf.
EMAIL_API_KEY=
# Verified sending domain in Resend. Verification mail is sent from
# noreply@<domain>.
EMAIL_DOMAIN=

# Emails allowed to create an account, comma-separated. Empty means nobody
# can sign up; existing accounts still work.
SIGNUP_EMAILS=
